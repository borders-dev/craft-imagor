{
  "name": "borders-dev/craft-imagor",
  "description": "Hands Craft's image transforms to imagor (libvips), so the site's server never downloads or resizes originals.",
  "type": "craft-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Borders Web Development",
      "homepage": "https://borders.dev"
    }
  ],
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "bwd\\imagor\\": "src/"
    }
  },
  "extra": {
    "handle": "imagor",
    "name": "imagor",
    "developer": "Borders Web Development",
    "developerUrl": "https://borders.dev",
    "class": "bwd\\imagor\\Imagor"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    }
  }
}
